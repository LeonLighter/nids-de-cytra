Plugins/**/Intermediate/

# Builds empaquetés, en gardant les icônes du projet
Build/*
!Build/*/
Build/*/**
!Build/**/*.ico

# Fichiers d'IDE (régénérables)
.vs/
.vscode/
.idea/
*.sln
*.suo
*.sdf
*.opensdf
*.VC.db
